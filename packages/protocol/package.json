{
  "name": "@pikit/protocol",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./catalog.example.json": "./catalog.example.json",
    "./catalogs/*.json": "./catalogs/*.json",
    "./abi/*.json": "./abi/*.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node dist/scripts/emit-schemas.js",
    "lint": "node scripts/export-abi.mjs --check && tsc -p tsconfig.json --noEmit",
    "test": "node --test \"dist/test/**/*.test.js\"",
    "abi:export": "forge build --root ../../contracts && node scripts/export-abi.mjs"
  },
  "dependencies": {
    "@noble/hashes": "1.8.0",
    "@openzeppelin/merkle-tree": "1.0.8",
    "viem": "2.57.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "typescript": "5.9.3"
  }
}
