{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "roomId": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "batchIndex": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "kinds": {
      "minItems": 2000,
      "maxItems": 2000,
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      }
    },
    "rowWindows": {
      "minItems": 200,
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    },
    "hash": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "anchoredEpoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    }
  },
  "required": [
    "roomId",
    "batchIndex",
    "kinds",
    "rowWindows",
    "hash"
  ],
  "additionalProperties": false
}
