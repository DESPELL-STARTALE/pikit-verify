{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "messages": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "shortId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^0x[0-9a-f]{4}…[0-9a-f]{4}$"
              },
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9]{1,12}$"
              }
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "at": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "shortId",
          "text",
          "at"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "messages"
  ],
  "additionalProperties": false
}
