{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "reason": {
      "type": "string",
      "enum": [
        "NOT_SIGNED_IN",
        "BAD_FORMAT",
        "EMPTY",
        "TOO_LONG",
        "RATE_LIMITED"
      ]
    },
    "retryAfterMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "reason"
  ],
  "additionalProperties": false
}
