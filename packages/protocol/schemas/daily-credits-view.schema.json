{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "day": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "claimed": {
      "type": "boolean"
    },
    "grantedCredits": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "targetCredits": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "baseCredits": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "nftHolder": {
      "type": "boolean"
    },
    "nftHolderCredits": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "snapshot": {
      "type": "object",
      "properties": {
        "block": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "at": {
          "type": "string",
          "minLength": 1
        },
        "nftCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "chogBalance": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        }
      },
      "required": [
        "block",
        "at",
        "nftCount",
        "chogBalance"
      ],
      "additionalProperties": false
    },
    "chogCredits": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "chogUnit": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "chogCreditsPerUnit": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "chogCapCredits": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "streakDays": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "bonus": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "STREAK",
            "RETURN"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "reason": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "ALREADY_CLAIMED",
            "FREE_CREDITS_EXHAUSTED",
            "NEW_WALLETS_EXHAUSTED",
            "HOLDERS_PENDING",
            "HOLDERS_UNAVAILABLE",
            "NEW_WALLETS_HOURLY",
            "NEW_WALLETS_NETWORK",
            "SYNCING",
            "PROMO_BUDGET_EXHAUSTED"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "grantStatus": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "PENDING",
            "LISTED",
            "APPLIED",
            "REJECTED",
            "SKIPPED"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "nextClaimAt": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "day",
    "claimed",
    "grantedCredits",
    "targetCredits",
    "baseCredits",
    "nftHolder",
    "nftHolderCredits",
    "snapshot",
    "chogCredits",
    "chogUnit",
    "chogCreditsPerUnit",
    "chogCapCredits",
    "streakDays",
    "bonus",
    "reason",
    "grantStatus",
    "nextClaimAt"
  ],
  "additionalProperties": false
}
