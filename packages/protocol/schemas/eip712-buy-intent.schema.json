{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "wallet": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{40}$"
    },
    "sessionKey": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{40}$"
    },
    "roomId": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "rulesHash": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "tiers": {
      "minItems": 1,
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 31
      }
    },
    "seq": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "targetWindow": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "wallet",
    "sessionKey",
    "roomId",
    "rulesHash",
    "tiers",
    "seq",
    "targetWindow"
  ],
  "additionalProperties": false
}
