{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "wallet": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{40}$"
    },
    "sessionKey": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{40}$"
    },
    "roomId": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "items": {
      "minItems": 1,
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(0|[1-9][0-9]*)$"
      }
    },
    "nonce": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "deadline": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    }
  },
  "required": [
    "wallet",
    "sessionKey",
    "roomId",
    "items",
    "nonce",
    "deadline"
  ],
  "additionalProperties": false
}
