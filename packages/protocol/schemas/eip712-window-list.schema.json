{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "window": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "entriesHash": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    }
  },
  "required": [
    "window",
    "entriesHash",
    "count"
  ],
  "additionalProperties": false
}
