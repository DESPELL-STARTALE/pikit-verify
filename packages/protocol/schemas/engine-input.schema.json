{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "purchase"
        },
        "ref": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "owner": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{40}$"
        },
        "tiers": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      },
      "required": [
        "type",
        "ref",
        "owner",
        "tiers"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "cancel"
        },
        "owner": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{40}$"
        },
        "itemKey": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*):[0-9]$"
        }
      },
      "required": [
        "type",
        "owner",
        "itemKey"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "freeze"
        },
        "reason": {
          "type": "string",
          "enum": [
            "FREEZE",
            "ROOM_CLOSED"
          ]
        }
      },
      "required": [
        "type",
        "reason"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "voidPurchase"
        },
        "ref": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "owner": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{40}$"
        }
      },
      "required": [
        "type",
        "ref",
        "owner"
      ],
      "additionalProperties": false
    }
  ]
}
