{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "kind": {
      "type": "string",
      "enum": [
        "POP",
        "BIG_POP",
        "BIG_PAYOUT",
        "QUEUE_SPAWN",
        "PICKAXE_END",
        "SKY_DROP",
        "SKY_CATCH"
      ]
    },
    "roomId": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "playerShortId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^0x[0-9a-f]{4}…[0-9a-f]{4}$"
        },
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9]{1,12}$"
        }
      ]
    },
    "itemKey": {
      "type": "string",
      "minLength": 1
    },
    "tier": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "amountMilli": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "streakCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "endReason": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "DURABILITY",
            "STUCK",
            "TIMER",
            "FREEZE",
            "ROOM_CLOSED",
            "VOID"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "overMilli": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "tick": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "blockNumber": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "skyId": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    }
  },
  "required": [
    "seq",
    "kind",
    "roomId",
    "playerShortId",
    "itemKey",
    "tier",
    "amountMilli",
    "streakCount",
    "endReason",
    "tick",
    "blockNumber"
  ],
  "additionalProperties": false
}
