{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "pikit.inputlog/v0"
    },
    "rulesHash": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "chainId": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "shop": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{40}$"
    },
    "roomId": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "seed": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "firstWindow": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "lastWindow": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "windows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "window": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "blockHash": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{64}$"
          },
          "inputs": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "purchase"
                    },
                    "ref": {
                      "type": "string",
                      "pattern": "^(0|[1-9][0-9]*)$"
                    },
                    "owner": {
                      "type": "string",
                      "pattern": "^0x[0-9a-f]{40}$"
                    },
                    "tiers": {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      }
                    }
                  },
                  "required": [
                    "type",
                    "ref",
                    "owner",
                    "tiers"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "cancel"
                    },
                    "owner": {
                      "type": "string",
                      "pattern": "^0x[0-9a-f]{40}$"
                    },
                    "itemKey": {
                      "type": "string",
                      "pattern": "^(0|[1-9][0-9]*):[0-9]$"
                    }
                  },
                  "required": [
                    "type",
                    "owner",
                    "itemKey"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "freeze"
                    },
                    "reason": {
                      "type": "string",
                      "enum": [
                        "FREEZE",
                        "ROOM_CLOSED"
                      ]
                    }
                  },
                  "required": [
                    "type",
                    "reason"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "voidPurchase"
                    },
                    "ref": {
                      "type": "string",
                      "pattern": "^(0|[1-9][0-9]*)$"
                    },
                    "owner": {
                      "type": "string",
                      "pattern": "^0x[0-9a-f]{40}$"
                    }
                  },
                  "required": [
                    "type",
                    "ref",
                    "owner"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          }
        },
        "required": [
          "window",
          "inputs"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "rulesHash",
    "chainId",
    "shop",
    "roomId",
    "seed",
    "firstWindow",
    "lastWindow",
    "windows"
  ],
  "additionalProperties": false
}
