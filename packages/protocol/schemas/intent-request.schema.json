{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "BUY"
        },
        "intent": {
          "type": "object",
          "properties": {
            "wallet": {
              "type": "string",
              "pattern": "^0x[0-9a-f]{40}$"
            },
            "sessionKey": {
              "type": "string",
              "pattern": "^0x[0-9a-f]{40}$"
            },
            "roomId": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "rulesHash": {
              "type": "string",
              "pattern": "^0x[0-9a-f]{64}$"
            },
            "tiers": {
              "minItems": 1,
              "maxItems": 10,
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 31
              }
            },
            "seq": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            "targetWindow": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "wallet",
            "sessionKey",
            "roomId",
            "rulesHash",
            "tiers",
            "seq",
            "targetWindow"
          ],
          "additionalProperties": false
        },
        "signature": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{130}$"
        },
        "session": {
          "type": "object",
          "properties": {
            "session": {
              "type": "object",
              "properties": {
                "wallet": {
                  "type": "string",
                  "pattern": "^0x[0-9a-f]{40}$"
                },
                "sessionKey": {
                  "type": "string",
                  "pattern": "^0x[0-9a-f]{40}$"
                },
                "expiresAt": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)$"
                }
              },
              "required": [
                "wallet",
                "sessionKey",
                "expiresAt"
              ],
              "additionalProperties": false
            },
            "signature": {
              "type": "string",
              "pattern": "^0x([0-9a-f]{2})*$"
            }
          },
          "required": [
            "session",
            "signature"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "kind",
        "intent",
        "signature"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "CANCEL"
        },
        "intent": {
          "type": "object",
          "properties": {
            "wallet": {
              "type": "string",
              "pattern": "^0x[0-9a-f]{40}$"
            },
            "sessionKey": {
              "type": "string",
              "pattern": "^0x[0-9a-f]{40}$"
            },
            "roomId": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "items": {
              "minItems": 1,
              "maxItems": 10,
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)$"
              }
            },
            "seq": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            "targetWindow": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "wallet",
            "sessionKey",
            "roomId",
            "items",
            "seq",
            "targetWindow"
          ],
          "additionalProperties": false
        },
        "signature": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{130}$"
        },
        "session": {
          "type": "object",
          "properties": {
            "session": {
              "type": "object",
              "properties": {
                "wallet": {
                  "type": "string",
                  "pattern": "^0x[0-9a-f]{40}$"
                },
                "sessionKey": {
                  "type": "string",
                  "pattern": "^0x[0-9a-f]{40}$"
                },
                "expiresAt": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)$"
                }
              },
              "required": [
                "wallet",
                "sessionKey",
                "expiresAt"
              ],
              "additionalProperties": false
            },
            "signature": {
              "type": "string",
              "pattern": "^0x([0-9a-f]{2})*$"
            }
          },
          "required": [
            "session",
            "signature"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "kind",
        "intent",
        "signature"
      ],
      "additionalProperties": false
    }
  ]
}
