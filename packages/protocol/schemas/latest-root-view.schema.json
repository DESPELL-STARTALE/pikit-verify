{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "root": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "epoch": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "seed": {
              "type": "string",
              "pattern": "^0x[0-9a-f]{64}$"
            },
            "throughWindow": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "roomsStateRoot": {
              "type": "string",
              "pattern": "^0x[0-9a-f]{64}$"
            },
            "inputLogRoot": {
              "type": "string",
              "pattern": "^0x[0-9a-f]{64}$"
            },
            "boardBatchRoot": {
              "type": "string",
              "pattern": "^0x[0-9a-f]{64}$"
            },
            "ledgerRoot": {
              "type": "string",
              "pattern": "^0x[0-9a-f]{64}$"
            },
            "payoutsRoot": {
              "type": "string",
              "pattern": "^0x[0-9a-f]{64}$"
            },
            "supplyMilli": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            "dataHash": {
              "type": "string",
              "pattern": "^0x[0-9a-f]{64}$"
            },
            "rootIndex": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "status": {
              "type": "string",
              "enum": [
                "READY",
                "SENT",
                "POSTED"
              ]
            },
            "txHash": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^0x[0-9a-f]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "postedBlock": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "epoch",
            "seed",
            "throughWindow",
            "roomsStateRoot",
            "inputLogRoot",
            "boardBatchRoot",
            "ledgerRoot",
            "payoutsRoot",
            "supplyMilli",
            "dataHash",
            "rootIndex",
            "status",
            "txHash",
            "postedBlock"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "freshness": {
      "type": "object",
      "properties": {
        "closedThrough": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "sinceWindow": {
          "type": "integer",
          "minimum": -1,
          "maximum": 9007199254740991
        },
        "ageBlocks": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "maxAgeBlocks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "salesOpen": {
          "type": "boolean"
        }
      },
      "required": [
        "closedThrough",
        "sinceWindow",
        "ageBlocks",
        "maxAgeBlocks",
        "salesOpen"
      ],
      "additionalProperties": false
    },
    "ledger": {
      "type": "object",
      "properties": {
        "address": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{40}$"
        },
        "chainId": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "genesisBlock": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "rootEveryEpochs": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "address",
        "chainId",
        "genesisBlock",
        "rootEveryEpochs"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "root",
    "freshness",
    "ledger"
  ],
  "additionalProperties": false
}
