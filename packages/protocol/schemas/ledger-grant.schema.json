{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "wallet": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{40}$"
    },
    "amountMilli": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "day": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "reason": {
      "type": "string",
      "enum": [
        "DAILY"
      ]
    }
  },
  "required": [
    "wallet",
    "amountMilli",
    "day",
    "reason"
  ],
  "additionalProperties": false
}
