{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "window": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "entriesHash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^0x[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "signer": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^0x[0-9a-f]{40}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "signature": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^0x[0-9a-f]{130}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "BUY",
              "CANCEL",
              "GRANT"
            ]
          },
          "roomId": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "ref": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{64}$"
          }
        },
        "required": [
          "kind",
          "roomId",
          "ref"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "window",
    "count",
    "entriesHash",
    "signer",
    "signature",
    "entries"
  ],
  "additionalProperties": false
}
