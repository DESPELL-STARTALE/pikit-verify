{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "itemKey": {
      "type": "string",
      "minLength": 1
    },
    "purchaseId": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "itemIndex": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9
    },
    "owner": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{40}$"
    },
    "roomId": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "tier": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "priceMilli": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "kind": {
      "type": "string",
      "enum": [
        "REWARD",
        "REFUND"
      ]
    },
    "cause": {
      "type": "string",
      "enum": [
        "END",
        "ABNORMAL_END",
        "CANCEL",
        "OVERFLOW",
        "QUEUE_REFUND"
      ]
    },
    "payoutMilli": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "overMilli": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "window": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "itemKey",
    "purchaseId",
    "itemIndex",
    "owner",
    "roomId",
    "tier",
    "priceMilli",
    "kind",
    "cause",
    "payoutMilli",
    "overMilli",
    "window"
  ],
  "additionalProperties": false
}
