{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "itemKey": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{40}$"
    },
    "roomId": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "tier": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "priceCredits": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "rulesVersion": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "spawnWindow": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "spawnTick": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "endWindow": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "endTick": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "endReason": {
      "type": "string",
      "enum": [
        "DURABILITY",
        "STUCK",
        "TIMER",
        "FREEZE",
        "ROOM_CLOSED",
        "VOID"
      ]
    },
    "hits": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "distinctBlocks": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "blocksBroken": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "durabilityUsed": {
      "type": "number",
      "minimum": 0
    },
    "durabilityTotal": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "pop": {
      "type": "boolean"
    },
    "bigPop": {
      "type": "boolean"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "POP",
              "BIG_POP"
            ]
          },
          "tick": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "window": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "blockKind": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "streakCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "prizeMilli": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "paidMilli": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "kind",
          "tick",
          "window",
          "blockKind",
          "streakCount",
          "prizeMilli",
          "paidMilli"
        ],
        "additionalProperties": false
      }
    },
    "luckyKind": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "baseMilli": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "luckyMilli": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "bonusMilli": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "paidMilli": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "overMilli": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "pnlMilli": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "itemKey",
    "owner",
    "roomId",
    "tier",
    "priceCredits",
    "rulesVersion",
    "spawnWindow",
    "spawnTick",
    "endWindow",
    "endTick",
    "endReason",
    "hits",
    "distinctBlocks",
    "blocksBroken",
    "durabilityUsed",
    "durabilityTotal",
    "pop",
    "bigPop",
    "events",
    "luckyKind",
    "baseMilli",
    "luckyMilli",
    "bonusMilli",
    "paidMilli",
    "overMilli",
    "pnlMilli"
  ],
  "additionalProperties": false
}
