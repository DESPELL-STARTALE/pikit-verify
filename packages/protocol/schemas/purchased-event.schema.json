{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "chainId": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "blockNumber": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "blockHash": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "txHash": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "logIndex": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "shop": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{40}$"
    },
    "purchaseId": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "buyer": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{40}$"
    },
    "roomId": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "rulesHash": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "seq": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "tiers": {
      "minItems": 1,
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 31
      }
    },
    "priceCredits": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    }
  },
  "required": [
    "chainId",
    "blockNumber",
    "blockHash",
    "txHash",
    "logIndex",
    "shop",
    "purchaseId",
    "buyer",
    "roomId",
    "rulesHash",
    "seq",
    "tiers",
    "priceCredits"
  ],
  "additionalProperties": false
}
