{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "roomId": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "playerShortId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^0x[0-9a-f]{4}…[0-9a-f]{4}$"
        },
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9]{1,12}$"
        }
      ]
    },
    "activeItemKey": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "itemKey": {
            "type": "string",
            "minLength": 1
          },
          "tier": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "priceMilli": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "itemKey",
          "tier",
          "priceMilli"
        ],
        "additionalProperties": false
      }
    },
    "queueMax": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "nextSpawnWindow": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "roomId",
    "playerShortId",
    "activeItemKey",
    "items",
    "queueMax",
    "nextSpawnWindow"
  ],
  "additionalProperties": false
}
