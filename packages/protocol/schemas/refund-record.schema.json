{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "VOID_PURCHASE",
        "QUEUE_REFUND",
        "CANCEL",
        "OVERFLOW",
        "ABNORMAL_END"
      ]
    },
    "owner": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{40}$"
    },
    "roomId": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "ref": {
      "type": "string",
      "minLength": 1
    },
    "window": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "amountMilli": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "onChain": {
      "type": "boolean"
    }
  },
  "required": [
    "kind",
    "owner",
    "roomId",
    "ref",
    "window",
    "amountMilli",
    "onChain"
  ],
  "additionalProperties": false
}
