{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "seed": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "throughWindow": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "roomsStateRoot": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "inputLogRoot": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "boardBatchRoot": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "ledgerRoot": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "payoutsRoot": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "supplyMilli": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "dataHash": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "rootIndex": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "status": {
      "type": "string",
      "enum": [
        "READY",
        "SENT",
        "POSTED"
      ]
    },
    "txHash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^0x[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "postedBlock": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "epoch",
    "seed",
    "throughWindow",
    "roomsStateRoot",
    "inputLogRoot",
    "boardBatchRoot",
    "ledgerRoot",
    "payoutsRoot",
    "supplyMilli",
    "dataHash",
    "rootIndex",
    "status",
    "txHash",
    "postedBlock"
  ],
  "additionalProperties": false
}
