{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "chainId": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "fairness": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{40}$"
    },
    "seedRoot": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "firstWindow": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "epochLength": {
      "type": "number",
      "const": 200
    }
  },
  "required": [
    "chainId",
    "fairness",
    "seedRoot",
    "firstWindow",
    "epochLength"
  ],
  "additionalProperties": false
}
