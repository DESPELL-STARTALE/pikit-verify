{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "chainId": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "blockNumber": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "blockHash": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "txHash": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "logIndex": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "purchaseId": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "itemIndex": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9
    },
    "buyer": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{40}$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "REWARD",
        "REFUND"
      ]
    },
    "payoutMilli": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "overMilli": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    }
  },
  "required": [
    "chainId",
    "blockNumber",
    "blockHash",
    "txHash",
    "logIndex",
    "purchaseId",
    "itemIndex",
    "buyer",
    "kind",
    "payoutMilli",
    "overMilli"
  ],
  "additionalProperties": false
}
