{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "weekStart": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "weekTickets": {
      "type": "integer",
      "minimum": 0,
      "maximum": 7
    },
    "ticketMinPickaxes": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "monthStart": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "monthPlayDays": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "todayPickaxes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "eligibility": {
      "type": "object",
      "properties": {
        "nft": {
          "type": "boolean"
        },
        "nftCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "token": {
          "type": "boolean"
        },
        "tokenDays": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "tokenMin": {
          "type": "string",
          "pattern": "^\\d+$"
        },
        "eligible": {
          "type": "boolean"
        }
      },
      "required": [
        "nft",
        "nftCount",
        "token",
        "tokenDays",
        "tokenMin",
        "eligible"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "weekStart",
    "weekTickets",
    "ticketMinPickaxes",
    "monthStart",
    "monthPlayDays",
    "todayPickaxes",
    "eligibility"
  ],
  "additionalProperties": false
}
