{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "day": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "bigPops": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "over1x": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "pickaxes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "players": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "asOf": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "day",
    "bigPops",
    "over1x",
    "pickaxes",
    "players",
    "asOf"
  ],
  "additionalProperties": false
}
